+    // Stellarchy remux: optional identity overlay. If
+    // ~/.config/stellarchy/os-release exists, its NAME/PRETTY_NAME/LOGO keys
+    // override the system values so the shell can be rebranded without
+    // touching /etc/os-release (fastfetch etc. keep reporting real Omarchy info).
+    FileView {
+        path: `${Quickshell.env("XDG_CONFIG_HOME") || `${Quickshell.env("HOME")}/.config`}/stellarchy/os-release`
+
+        printErrors: false
+        blockLoading: true
+
+        onLoaded: {
+            const lines = text().split("\n");
+            const fd = key => lines.find(l => l.startsWith(`${key}=`))?.split("=")[1].replace(/"/g, "") ?? "";
+
+            const name = fd("NAME");
+            if (name) root.osName = name;
+
+            const prettyName = fd("PRETTY_NAME");
+            if (prettyName) root.osPrettyName = prettyName;
+
+            const logo = fd("LOGO");
+            if (logo) {
+                root.osLogo = Quickshell.iconPath(logo, true) || `file://${logo}`;
+                root.isDefaultLogo = false;
+            }
+        }
+    }
+

#!/bin/bash

# stellarchy:summary=Hardware toggles gated on detected hardware (laptop display, hybrid GPU, touchpad...).

menu=""
declare -A cmd_for=()

# add <label> <condition-cmd> <action...> — the row only appears when the
# condition command succeeds (mirrors omarchy-menu.jsonc "when" fields).
add() {
  local label=$1 cond=$2
  shift 2
  [[ -n $cond ]] && ! "$cond" >/dev/null 2>&1 && return 0
  cmd_for[$label]="$*"
  menu+="$label"$'\n'
}

add 'Laptop Display' omarchy-hw-laptop        omarchy-hyprland-monitor-internal toggle
add 'Mirror Display' omarchy-hw-laptop        omarchy-hyprland-monitor-internal-mirror toggle
add 'Hybrid GPU'     omarchy-hw-hybrid-gpu    stellarchy-terminal omarchy-toggle-hybrid-gpu
add 'Touchpad'       omarchy-hw-touchpad      omarchy-toggle-touchpad
add 'Touchscreen'    omarchy-hw-touchscreen   omarchy-toggle-touchscreen

[[ -n $menu ]] || exit 0   # nothing applies to this machine

choice=$(
  printf '%s' "$menu" |
    stellarchy-fuzzel --dmenu --prompt='Hardware: ' --width=26 --lines=${#cmd_for[@]}
) || exec stellarchy-trigger   # Esc = back to Trigger menu

cmd=${cmd_for[$choice]:-}
[[ -n $cmd ]] && eval exec "$cmd"

#!/bin/bash

# stellarchy:summary=Kernel submenu: opt into a CachyOS kernel, or check boot-entry health.

# CachyOS kernel variants installable via chaotic-aur: variant -> base package.
declare -A KERNEL_PKGS=(
  [default]="linux-cachyos"
  [bore]="linux-cachyos-bore"
  [eevdf]="linux-cachyos-eevdf"
  [lts]="linux-cachyos-lts"
  [rt-bore]="linux-cachyos-rt-bore"
)

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; NC='\033[0m'
info() { echo -e "${CYAN}[stellarchy]${NC} $*"; }
ok()   { echo -e "${GREEN}[stellarchy]${NC} $*"; }
warn() { echo -e "${YELLOW}[stellarchy]${NC} $*"; }
err()  { echo -e "${RED}[stellarchy]${NC} $*" >&2; }

# Install <variant> via chaotic-aur (stock kernel is never removed) and aim
# Limine's default_entry header at it by path, so it survives kernel add/remove
# and snapshot churn where a computed index silently shifts onto whatever takes
# the removed entry's place (e.g. the Snapshots submenu).
do_kernel() {
  local kern=$1 base=${KERNEL_PKGS[$1]}
  rr() { sudo "$@"; }

  if pacman -Q "$base" &>/dev/null; then
    ok "$base already installed"
  else
    if ! grep -q '^\[chaotic-aur\]' /etc/pacman.conf; then
      info "adding chaotic-aur repo..."
      rr pacman-key --recv-key 3056513887B78AEB --keyserver keyserver.ubuntu.com
      rr pacman-key --lsign-key 3056513887B78AEB
      rr bash -c "pacman -U --noconfirm 'https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-keyring.pkg.tar.zst' 'https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-mirrorlist.pkg.tar.zst'"
      [[ -f /etc/pacman.conf.stellarchy-backup ]] || rr cp /etc/pacman.conf /etc/pacman.conf.stellarchy-backup
      printf '\n[chaotic-aur]\nInclude = /etc/pacman.d/chaotic-mirrorlist\n' | sudo tee -a /etc/pacman.conf >/dev/null
    else
      ok "chaotic-aur already configured"
    fi
    rr pacman -Sy --noconfirm
    rr pacman -S --ask 4 --noconfirm "$base" "$base-headers"
  fi

  # Regenerate entries first so this kernel's subentry exists in limine.conf
  rr limine-update

  if [[ -f /boot/limine.conf ]]; then
    local want="+Omarchy/$base"
    if grep -q "^default_entry:[[:space:]]*$want\$" /boot/limine.conf; then
      ok "already the default boot entry"
    else
      info "default boot entry -> $base"
      rr sed -i "s|^default_entry:.*|default_entry: $want|" /boot/limine.conf
    fi
  fi
  ok "$base ready (stock kernel kept as fallback)"
}

# Health check: report which kernel boots first; repair a stale numeric
# default_entry left over from before the path-format switch.
do_status() {
  local installed want cur
  if installed=$(pacman -Qq 2>/dev/null | grep '^linux-cachyos' | grep -v headers | head -1) && [[ -n $installed ]]; then
    want="+Omarchy/$installed"
    cur="$(sed -n 's/^default_entry:[[:space:]]*//p' /boot/limine.conf 2>/dev/null || true)"
    if [[ $cur == "$want" ]]; then
      ok "$installed present, default boot entry configured"
    elif [[ $cur =~ ^[0-9]+$ ]]; then
      warn "stale numeric default_entry ($cur) — repointing at $installed"
      sudo sed -i "s|^default_entry:.*|default_entry: $want|" /boot/limine.conf
      ok "$installed is now the default boot entry"
    else
      warn "$installed present but stock kernel still auto-boots first"
      warn "re-run this menu and pick a variant to fix"
    fi
  else
    ok "stock Arch kernel (opt in anytime via this menu)"
  fi
}

if [[ ${1:-} == run ]]; then
  set -e
  shift
  case $1 in
    status) do_status ;;
    *) [[ -n ${KERNEL_PKGS[$1]:-} ]] || { err "unknown kernel variant '$1'"; exit 1; }
       do_kernel "$1" ;;
  esac
  exit 0
fi

# ── Menu ──
declare -A cmd_for=()
add() { cmd_for[$1]=$2; menu+="$1"$'\n'; }
menu=""
add 'Default — CachyOS current'  'default'
add 'BORE — gaming/interactive'  'bore'
add 'EEVDF — explicit build'     'eevdf'
add 'LTS — long-term support'    'lts'
add 'Real-time BORE'             'rt-bore'
add 'Status & repair'            'status'

choice=$(
  printf '%s' "$menu" |
    stellarchy-fuzzel --dmenu --prompt='Kernel: ' --width=30 --lines=${#cmd_for[@]}
) || exec stellarchy-menu   # Esc = back to root menu

exec stellarchy-terminal stellarchy-kernel run "${cmd_for[$choice]}"

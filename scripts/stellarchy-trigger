#!/bin/bash

# stellarchy:summary=Trigger submenu: hardware toggles and speed tests.

# Rows ending in ">" open a submenu.
choice=$(
  printf '%s\n' \
    'Hardware >' \
    'Speed Test >' |
    stellarchy-fuzzel --dmenu --prompt='Trigger: ' --width=26 --lines=2
) || exec stellarchy-menu   # Esc = back to root menu
choice=${choice%' >'}

case "$choice" in
  "Hardware")   exec stellarchy-hardware ;;
  "Speed Test") exec stellarchy-speedtest ;;
esac

#!/bin/bash

# stellarchy:summary=Update menu: system, channel, themes, restarts, firmware.

current=$(omarchy channel current 2>/dev/null)

# Rows ending in ">" drill into another picker; bare rows act immediately.
entries=("Stellarchy" "Channel${current:+ ($current)} >")
omarchy-theme-extras >/dev/null 2>&1 && entries+=('Extra themes')
entries+=('Hyprsunset' 'Hardware >' 'Firmware')

choice=$(
  printf '%s\n' "${entries[@]}" |
    stellarchy-fuzzel --dmenu --prompt='Update: ' --width=30 --lines=${#entries[@]}
) || exec stellarchy-menu   # Esc = back to root menu
choice=${choice%' >'}

case "$choice" in
  Stellarchy)     exec omarchy-launch-or-focus-tui --app-id=TUI.float omarchy-update ;;
  "Extra themes") exec omarchy-launch-or-focus-tui --app-id=TUI.float omarchy-theme-update ;;
  Hyprsunset)     exec omarchy-restart-hyprsunset ;;
  Hardware)       exec stellarchy-update-hardware ;;
  Firmware)       exec omarchy-launch-or-focus-tui --app-id=TUI.float omarchy-update-firmware ;;
  Channel*) ;;
  *) exit 0 ;;
esac

# Channel picker; switching needs sudo, so run it in a terminal.
chan_choice=$(
  printf '%s\n' stable rc edge dev |
    awk -v cur="$current" '$0 == cur { print "✓ " $0; next } { print }' |
    stellarchy-fuzzel --dmenu --prompt='Channel: ' --width=22 --lines=4
) || exec stellarchy-update   # Esc = back to Update menu

channel=${chan_choice#✓ }
[[ -n $channel ]] && exec omarchy-launch-or-focus-tui --app-id=TUI.float omarchy-channel-set "$channel"

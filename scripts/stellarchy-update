#!/bin/bash

# stellarchy:summary=Update menu: system, themes, firmware, or switch update channel.

current=$(omarchy channel current 2>/dev/null)

choice=$(
  printf '%s\n' \
    'Update system' \
    'Update themes' \
    'Update firmware' \
    "Update channel${current:+ ($current)}" |
    stellarchy-fuzzel --dmenu --prompt='Update: ' --width=30 --lines=4
) || exec stellarchy-menu   # Esc = back to root menu

case "$choice" in
  "Update system")   exec omarchy-launch-or-focus-tui omarchy-update ;;
  "Update themes")   exec omarchy-launch-or-focus-tui omarchy-theme-update ;;
  "Update firmware") exec omarchy-launch-or-focus-tui omarchy-update-firmware ;;
  "Update channel"*) ;;
  *) exit 0 ;;
esac

# Channel picker; switching needs sudo, so run it in a terminal.
chan_choice=$(
  printf '%s\n' stable rc edge dev |
    awk -v cur="$current" '$0 == cur { print "✓ " $0; next } { print }' |
    stellarchy-fuzzel --dmenu --prompt='Channel: ' --width=22 --lines=4
) || exec stellarchy-update   # Esc = back to Update menu

channel=${chan_choice#✓ }
[[ -n $channel ]] && exec omarchy-launch-or-focus-tui omarchy-channel-set "$channel"

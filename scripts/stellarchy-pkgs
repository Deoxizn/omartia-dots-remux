#!/bin/bash

# stellarchy:summary=Packages submenu: install or remove packages, AUR builds, web apps, themes.

# Rows ending in ">" open a submenu.
choice=$(
  printf '%s\n' \
    'Install >' \
    'Remove >' |
    stellarchy-fuzzel --dmenu --prompt='Packages: ' --width=26 --lines=2
) || exec stellarchy-menu   # Esc = back to root menu
choice=${choice%' >'}

case "$choice" in
  Install) exec stellarchy-install ;;
  Remove)  exec stellarchy-remove ;;
esac

#!/bin/bash

# stellarchy: print the dots revision as r<count>.<sha> for the fastfetch OS line.
# Usage: stellarchy-version [repo_dir]
#
# Resolves the checkout via: explicit arg → state file → baked hook path → XDG default.
# Prints nothing when no usable checkout exists so callers can degrade to plain branding.

repo="$1"
if [[ -z $repo ]]; then
  state_file="$HOME/.local/state/stellarchy/repo-dir"
  baked_dir=$(sed -n 's/^REPO_DIR="\(.*\)"$/\1/p' "$HOME/.config/omarchy/hooks/post-update.d/stellarchy-repo-sync.sh" 2>/dev/null)

  # State file (authoritative)
  if [[ -f $state_file ]]; then
    stored=$(<"$state_file")
    [[ -d $stored ]] && repo="$stored"
  fi
  # Baked path from install hook
  if [[ -z $repo && -n $baked_dir && -d $baked_dir ]]; then
    repo="$baked_dir"
  fi
  # XDG default
  if [[ -z $repo && -d $HOME/.local/opt/stellarchy ]]; then
    repo="$HOME/.local/opt/stellarchy"
  fi
fi

[[ -z $repo ]] && exit 0

cnt=$(git -C "$repo" rev-list --count HEAD 2>/dev/null)
sha=$(git -C "$repo" rev-parse --short HEAD 2>/dev/null)
[[ -n $cnt && -n $sha ]] && printf 'r%s.%s\n' "$cnt" "$sha"

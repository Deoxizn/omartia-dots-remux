{
  "lock": {
    "enabled": true
  },
  "dashboard": {
    "enabled": true
  },
  "launcher": {
    "enabled": true
  },
  "sidebar": {
    "enabled": true,
    "showOnHover": true
  },
  "session": {
    "enabled": true,
    "commands": {
      "logout": ["loginctl", "terminate-user", "$USER"],
      "shutdown": ["poweroff"],
      "reboot": ["reboot"],
      "hibernate": ["systemctl", "hibernate"]
    }
  },
  "osd": {
    "enabled": true
  },
  "appearance": {
    "deformScale": 1.0,
    "rounding": { "scale": 1.0 },
    "spacing": { "scale": 1.0 },
    "padding": { "scale": 1.0 },
    "font": {
      "scale": 1.0,
      "mono": {
        "family": "JetBrainsMono Nerd Font"
      }
    },
    "transparency": {
      "enabled": true,
      "base": 0.85,
      "layers": 0.75
    }
  }
}

{
  "lock": {
    "enabled": true
  },
  "dashboard": {
    "enabled": true
  },
  "launcher": {
    "enabled": true,
    "hiddenApps": [
      "avahi-discover", "Basecamp", "bssh", "btop", "bvnc",
      "cmake-gui", "cups", "Discord", "Disk Usage", "Docker",
      "dropbox", "electron34", "electron36", "electron37",
      "fcitx5-configtool", "fcitx5-wayland-launcher", "foot",
      "foot-server", "footclient", "Google Contacts", "Google Maps",
      "Google Messages", "Google Photos", "HEY", "imv",
      "java-java-openjdk", "java-java17-openjdk",
      "jconsole-java-openjdk", "jconsole-java17-openjdk",
      "jshell-java-openjdk", "jshell-java17-openjdk",
      "kbd-layout-viewer5", "kcm_fcitx5", "kcm_kaccounts",
      "kvantummanager", "limine-snapper-restore", "lstopo", "mpv",
      "org.fcitx.Fcitx5", "org.fcitx.fcitx5-config-qt",
      "org.fcitx.fcitx5-migrator", "org.fcitx.fcitx5-qt5-gui-wrapper",
      "org.fcitx.fcitx5-qt6-gui-wrapper", "qv4l2", "qvidcap",
      "uuctl", "WhatsApp", "X", "xgps", "xgpsspeed", "YouTube", "Zoom"
    ]
  },
  "sidebar": {
    "enabled": true
  },
  "session": {
    "enabled": true,
    "commands": {
      "logout": ["loginctl", "terminate-user", "$USER"],
      "shutdown": ["poweroff"],
      "reboot": ["reboot"],
      "hibernate": ["systemctl", "hibernate"]
    }
  },
  "osd": {
    "enabled": true
  },
  "appearance": {
    "deformScale": 1.0,
    "rounding": { "scale": 1.0 },
    "spacing": { "scale": 1.0 },
    "padding": { "scale": 1.0 },
    "font": {
      "scale": 1.0,
      "mono": {
        "family": "JetBrainsMono Nerd Font"
      }
    },
    "transparency": {
      "enabled": true,
      "base": 0.85,
      "layers": 0.75
    }
  }
}

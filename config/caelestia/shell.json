{
  "lock": {
    "enabled": true
  },
  "dashboard": {
    "enabled": true
  },
  "launcher": {
    "enabled": true,
    "hiddenApps": [
      "avahi-discover", "bssh", "bvnc", "btop",
      "cmake-gui", "cups", "system-config-printer",
      "lstopo", "limine-snapper-restore", "user-dirs-update-gtk", "uuctl",
      "foot-server", "footclient",
      "qv4l2", "qvidcap",
      "gnome-disk-image-mounter", "gnome-disk-image-writer",
      "nautilus-autorun-software",
      "gcr-prompter", "gcr-viewer",
      "xdg-desktop-portal-gtk", "org.freedesktop.Xwayland",
      "org.gnupg.pinentry-qt", "org.quickshell",
      "org.fcitx.Fcitx5", "fcitx5-configtool",
      "org.fcitx.fcitx5-qt5-gui-wrapper", "org.fcitx.fcitx5-qt6-gui-wrapper",
      "fcitx5-wayland-launcher",
      "org.gnome.Evince-previewer",
      "imv-dir"
    ]
  },
  "sidebar": {
    "enabled": true,
    "showOnHover": true
  },
  "session": {
    "enabled": true,
    "commands": {
      "logout": ["loginctl", "terminate-user", "$USER"],
      "shutdown": ["poweroff"],
      "reboot": ["reboot"],
      "hibernate": ["systemctl", "hibernate"]
    }
  },
  "osd": {
    "enabled": true
  },
  "appearance": {
    "deformScale": 1.0,
    "rounding": { "scale": 1.0 },
    "spacing": { "scale": 1.0 },
    "padding": { "scale": 1.0 },
    "font": {
      "scale": 1.0,
      "mono": {
        "family": "JetBrainsMono Nerd Font"
      }
    },
    "transparency": {
      "enabled": true,
      "base": 0.85,
      "layers": 0.75
    }
  }
}
